{
  "name": "pensivo",
  "version": "1.0.0",
  "description": "A modern, beautiful notes app for developers and writers",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently --kill-others \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build:renderer": "vite build",
    "build": "vite build && electron-builder --win --x64",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux",
    "start": "electron .",
    "pack": "vite build && electron-builder --dir"
  },
  "keywords": ["notes", "editor", "markdown", "notepad", "pensivo"],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JamesCowx/pensivo"
  },
  "bugs": {
    "url": "https://github.com/JamesCowx/pensivo/issues"
  },
  "homepage": "https://JamesCowx.github.io/pensivo",
  "type": "commonjs",
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.5",
    "@uiw/react-codemirror": "^4.23.10",
    "codemirror": "^6.0.1",
    "marked": "^18.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.pensivo.app",
    "productName": "Pensivo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "artifactName": "Pensivo-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Pensivo-Portable-${version}.exe"
    }
  }
}
